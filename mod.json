{
  "_QPVersion": "0.1.1",
  "name": "Optional Qounters++",
  "id": "qppopt",
  "modloader": "Scotland2",
  "author": "Metalit",
  "version": "1.1.4",
  "packageId": "com.beatgames.beatsaber",
  "packageVersion": "1.40.8_7379",
